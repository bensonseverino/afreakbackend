{
  "name": "my-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cf:dev": "npm run build && wrangler pages dev dist",
    "cf:dev:proxy": "wrangler pages dev --proxy 5173 -- npm run dev",
    "db:migrate:local": "wrangler d1 migrations apply afreak-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply afreak-db --remote",
    "db:seed:local": "wrangler d1 execute afreak-db --local --file=./seeds/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute afreak-db --remote --file=./seeds/0002_seed.sql",
    "db:export": "wrangler d1 export afreak-db --remote --output=backup.sql",
    "smoke:account": "node scripts/account-smoke.mjs",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler pages deploy dist --project-name afreakcms"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.1"
  }
}
